# PostgreSQL connection string
# If you use docker-compose db service, keep the default value below.
DATABASE_URL=postgresql://order_user:order_pass@localhost:5432/order_system?schema=public

# JWT secret for admin authentication
JWT_SECRET=replace-with-secure-secret

# Public base url used by server-side fetches in customer pages
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: demo ids from prisma seed output (system also supports fallback flow)
NEXT_PUBLIC_DEMO_STORE_ID=
NEXT_PUBLIC_DEMO_TABLE_ID=
